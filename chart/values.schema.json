{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Values for elasticip chart",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "description": "Number of replicas."
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Image repository."
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": {
          "type": "string",
          "description": "Image tag."
        }
      }
    },
    "elasticIp": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the Elastic IP resource."
        },
        "someOtherValue": {
          "type": "string",
          "description": "A placeholder value."
        }
      },
      "required": ["name"]
    }
  }
}
